APP_NAME=FluxFile API
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
TEMP_DIRECTORY=./.tmp
STORAGE_BACKEND=local
FILE_RETENTION_SECONDS=86400
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=524288000
IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_WIDTH=8000
IMAGE_MAX_HEIGHT=8000
IMAGE_MIN_TARGET_SIZE_BYTES=1024
IMAGE_MAX_TARGET_SIZE_BYTES=52428800
IMAGE_TARGET_SEARCH_MAX_ATTEMPTS=8
IMAGE_MIN_QUALITY=35
IMAGE_MAX_QUALITY=92
IMAGE_TARGET_RESIZE_MAX_ATTEMPTS=10
IMAGE_TARGET_RESIZE_FACTOR=0.85
IMAGE_TARGET_MIN_DIMENSION=32
IMAGE_BEST_QUALITY_DEFAULT=92
IMAGE_BALANCED_QUALITY_DEFAULT=80
IMAGE_SMALLEST_QUALITY_DEFAULT=55
IMAGE_TARGET_MIN_QUALITY_DEFAULT=45
IMAGE_PNG_LOSSLESS_QUALITY_THRESHOLD=90
IMAGE_PNG_PALETTE_QUALITY_THRESHOLDS=[75,60,40,25]
IMAGE_PNG_PALETTE_COLORS=[256,128,64,32,16]
IMAGE_CONVERSION_JPEG_QUALITY=90
IMAGE_CONVERSION_WEBP_QUALITY=88
IMAGE_CONVERSION_ICO_SIZES=[16,24,32,48,64,128,256]
IMAGE_QUEUE_NAME=image-cpu
GUEST_IMAGE_MAX_UPLOAD_SIZE_BYTES=104857600
GUEST_IMAGE_MAX_PIXELS=24000000
GUEST_IMAGE_MAX_JOBS_PER_HOUR=30
GUEST_IMAGE_MAX_CONCURRENT_JOBS=4
GUEST_MAX_UPLOAD_SIZE_BYTES=2147483648
GUEST_MAX_DURATION_SECONDS=3600
GUEST_MAX_RESOLUTION_HEIGHT=1080
GUEST_MAX_JOBS_PER_HOUR=10
GUEST_MAX_CONCURRENT_JOBS=2
RATE_LIMIT_HASH_SALT=replace-with-a-secret-random-value
FREE_MAX_DURATION_SECONDS=600
FREE_MAX_RESOLUTION_HEIGHT=1080
JOB_TTL_SECONDS=86400
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=3600
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
PROGRESS_PERSIST_INTERVAL_SECONDS=1.0
REDIS_URL=redis://localhost:6379/0
RQ_COMPRESSION_QUEUE_NAME=compression
CPU_QUEUE_NAME=video-cpu
GPU_QUEUE_NAME=video-gpu
GPU_ENABLED=false
GPU_FALLBACK_TO_CPU=true
GPU_MIN_COMPLEXITY=heavy
GPU_AVAILABLE_ENCODERS=h264_nvenc
